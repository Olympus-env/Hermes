# --- HERMES configuration ---
# Copier en .env et adapter

# Backend
HERMES_HOST=127.0.0.1
HERMES_PORT=8000
HERMES_DEBUG=true

# Base de données (chemin SQLite)
HERMES_DB_PATH=./data/hermes.db

# Stockage des documents téléchargés
HERMES_STORAGE_PATH=./data/storage

# Ollama / PYTHIA (préfixe HERMES_ obligatoire pour être pris en compte)
HERMES_OLLAMA_BASE_URL=http://127.0.0.1:11434
HERMES_PYTHIA_MODELE=qwen3:8b
HERMES_PYTHIA_MODELE_EMBEDDINGS=nomic-embed-text

# Logs
HERMES_LOG_LEVEL=INFO
HERMES_LOG_PATH=./data/logs

# Sécurité : clé maître (sera générée automatiquement au premier démarrage si absente)
# HERMES_MASTER_KEY=
# HERMES_MASTER_KEY_PATH=./data/master.key

# KRINOS — juge Laya (modèle open source, exécuté en local via ONNX Runtime),
# OPTIONNEL et désactivé par défaut. Aucune clé, aucun budget : rien ne sort de la
# machine. Les poids (~0,7 Go en fp16) ne sont téléchargés (Hugging Face, SHA-256
# vérifié) qu'après un clic de consentement dans Paramètres, jamais au démarrage.
# HERMES_LAYA_ACTIF=false
# HERMES_LAYA_PRECISION=fp16        # fp16 (~0,7 Go) ou fp32 (~1,3 Go)
# HERMES_LAYA_MAX_TOKENS=1024       # contexte lu par Laya (1024 = entraînement, max 8192)
# HERMES_LAYA_DOSSIER=              # défaut : <dossier de données HERMES>/modeles/laya
